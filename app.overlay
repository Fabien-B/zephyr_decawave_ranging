
&spi3 {
    compatible = "pdec,nrf52833-spim3";
    status = "okay";
    dwm3001c@0 {
        compatible = "decawave,dw3000";
        spi-max-frequency = <32000000>;
        reg = <0>;
        irq-gpios     = <&gpio1 2 GPIO_ACTIVE_HIGH>;
        reset-gpios   = <&gpio0 25 GPIO_ACTIVE_LOW>;
    };
};

/* Keep zephyr,console on the physical UART. USB is a second protocol port. */
&zephyr_udc0 {
    status = "okay";
    pdec_usb_uart: pdec_usb_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};
